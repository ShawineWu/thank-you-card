# Backend Environment Variables

# Server Configuration
PORT=8080
ANALYTICS_PORT=8081
GIN_MODE=debug

# Database Configuration
DATABASE_URL=postgresql://thankyoucard:password@localhost:5432/thankyoucard?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=thankyoucard
DB_PASSWORD=password
DB_NAME=thankyoucard

# Azure AD Configuration (Teams App)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID_TEAMS_APP=your-teams-app-client-id
AZURE_CLIENT_SECRET_TEAMS_APP=your-teams-app-secret
AZURE_CLIENT_ID_BACKEND_API=your-backend-api-client-id

# Hydra Configuration (Web Dashboard)
HYDRA_PUBLIC_URL=https://hydra-test.castlery.com
HYDRA_JWKS_URL=https://hydra-test.castlery.com/.well-known/jwks.json
AZURE_JWKS_URL=https://login.microsoftonline.com/${AZURE_TENANT_ID}/discovery/v2.0/keys

# PLAT UMS
PLAT_UMS_SERVER=https://plat-ums-api-test.cslr.io

# Teams Channel Integration
TEAMS_CHANNEL_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://thank-you-card-test.castlery.com

# JWT Configuration
JWT_ISSUER=https://hydra-test.castlery.com,https://login.microsoftonline.com/${AZURE_TENANT_ID}/v2.0
JWT_AUDIENCE=api://thank-you-card-api

# Employee Directory Service (External)
EMPLOYEE_DIRECTORY_API=https://employee-directory-api.castlery.com
