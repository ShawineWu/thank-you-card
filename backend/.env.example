# Database Configuration
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database?sslmode=disable
DATABASE_DSN=postgres://postgres:123456@localhost:5432/thankyoucard?sslmode=disable

# Server Configuration
# Port for the HTTP server (default: 8056)
PORT=8056

# Mock User Configuration
# For MVP, we use a mock user ID instead of real authentication
# Set this to the ID of an employee in the database
# Default: 1 (first seeded employee)
# For HR admin access, set to 2
MOCK_USER_ID=1

# Environment
# Set to "production" for production mode, "development" for development
ENV=development

# CORS Configuration (optional, for future use)
# CORS_ORIGINS=http://localhost:8099,http://localhost:5173

# Teams Webhook Configuration
# Microsoft Teams webhook URL for sending card notifications to Teams channel
# Leave empty to disable Teams notifications
# THANK_YOU_CARD_WEB_HOOK=https://your-teams-webhook-url

# CASTLERY Logo URL
# Publicly accessible URL for the CASTLERY company logo to display in Teams cards
# If not set, a placeholder will be used
# Example: https://your-domain.com/castlery-logo.png
# CASTLERY_LOGO_URL=

# DeepSeek API Configuration
# DeepSeek API key for AI text generation
# Get your API key from https://platform.deepseek.com/api_keys
# Leave empty to disable AI generation (will use simple template)
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com